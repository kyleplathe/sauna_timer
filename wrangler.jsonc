{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sauna-timer",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Apex kyleplathe.com is reserved for the personal blog (separate host).
  // This worker only serves the lab + timer under /dev.
  "routes": [
    {
      "pattern": "kyleplathe.com/dev",
      "zone_name": "kyleplathe.com",
    },
    {
      "pattern": "kyleplathe.com/dev/*",
      "zone_name": "kyleplathe.com",
    },
  ],
}
