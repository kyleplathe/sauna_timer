{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sauna-timer",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "kyleplathe.com",
      "custom_domain": true,
    },
    {
      "pattern": "kyleplathe.com/*",
      "zone_name": "kyleplathe.com",
    },
  ],
}
